{
  "name": "@lightfastgrid/react",
  "version": "0.1.0",
  "description": "React package for LightFastGrid, a JavaScript data grid for large client-side datasets.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.gz",
    "!dist/**/*.br",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@lightfastgrid/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lightfastgrid/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @lightfastgrid/core run build",
    "build": "vite build",
    "predev": "pnpm --filter @lightfastgrid/core run build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:package-output": "pnpm run typecheck:package-output:bundler && pnpm run typecheck:package-output:nodenext && pnpm run typecheck:package-output:node16",
    "typecheck:package-output:bundler": "tsc --noEmit -p tsconfig.package-output.json",
    "typecheck:package-output:nodenext": "tsc --noEmit -p tsconfig.package-output.nodenext.json",
    "typecheck:package-output:node16": "tsc --noEmit -p tsconfig.package-output.node16.json"
  },
  "keywords": [
    "data-grid",
    "react",
    "table",
    "virtual-scroll",
    "virtualization",
    "performance",
    "lightfastgrid"
  ],
  "author": "Manzoor",
  "license": "MIT",
  "homepage": "https://lightfastgrid.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightfastgrid/grid.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/lightfastgrid/grid/issues"
  },
  "packageManager": "pnpm@10.33.2"
}
