{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {},
    "rootDir": "src",
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "css.d.ts"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/__typechecks__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "dist",
    "node_modules"
  ]
}
