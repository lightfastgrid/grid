{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {},
    "rootDir": "src",
    "declarationMap": false
